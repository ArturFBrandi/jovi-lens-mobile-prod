{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "functions": { "api/**/*.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
