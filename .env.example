# JOVI Lens — variáveis de ambiente. Mantenha este arquivo sem valores reais.
# Servidor: Vercel (Production) e o .env da raiz localmente. App: perfis do
# eas.json / EAS env (veja prod-implementation-spec.md §3).

# =========================================================================
# Servidor (sem prefixo — nunca use VITE_ ou EXPO_PUBLIC_ para segredos)
# =========================================================================

# --- Provedor de IA pago pelo servidor (créditos gratuitos) --------------
# azure-openai | gemini | openai | minimax. Em produção: minimax (prod-web-android-spec.md D9).
AI_PROVIDER=gemini

# --- Google Gemini --------------------------------------------------------
# Chave do servidor (Google AI Studio, plano gratuito). Obrigatória em produção.
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Só usados com a chave do usuário (BYOK) — usuários gratuitos não têm TTS/STT no servidor.
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# Vozes por papel (entre as 30 vozes prontas do Gemini).
# GEMINI_VOICE_A=Aoede
# GEMINI_VOICE_B=Charon
# GEMINI_VOICE_NARRATOR=Kore
# GEMINI_VOICE_COACH=Leda
# GEMINI_VOICE_FEEDBACK=Orus

# --- OpenAI (somente BYOK: a chave vem do usuário) ------------------------
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_VOICE_A=nova
# OPENAI_VOICE_B=onyx
# OPENAI_VOICE_NARRATOR=alloy
# OPENAI_VOICE_COACH=nova
# OPENAI_VOICE_FEEDBACK=onyx

# --- MiniMax (IA do servidor, D9; também aceito como BYOK) -----------------
# Sem transcrição (STT). Os padrões ficam em api/_lib/ai/providers/minimax.js.
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_TTS_BASE_URL=https://api-uw.minimax.io
# MINIMAX_CHAT_MODEL=MiniMax-Text-01   # chamadas só de texto (M3 mistura inglês/chinês em pt-BR)
# MINIMAX_VISION_MODEL=MiniMax-M3      # chamadas com imagem
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_VOICE_A=Portuguese_ChattyGirl
# MINIMAX_VOICE_B=Portuguese_WiseScholar
# MINIMAX_VOICE_NARRATOR=Portuguese_Narrator

# --- Azure OpenAI (opcional, só como provedor do servidor) ----------------
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
# AZURE_OPENAI_TTS_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe
# AZURE_OPENAI_TRANSCRIBE_API_VERSION=2025-04-01-preview

# --- Login Google e sessão ------------------------------------------------
# Client ID OAuth do tipo "Web application" (aceita lista separada por vírgula).
GOOGLE_CLIENT_ID=
# Assina a sessão do app (30 dias). Gere com: openssl rand -hex 32
JOVI_SESSION_SECRET=
# Chave compartilhada enviada pelo app no header x-api-key (a mesma de
# EXPO_PUBLIC_JOVI_API_KEY). Gere com: openssl rand -hex 32
JOVI_API_KEY=

# --- Play Integrity (desligado nesta versão — prod-web-android-spec.md D8) --
# Deixe sem valor ou false. As variáveis PLAY_INTEGRITY_* só são exigidas
# quando JOVI_REQUIRE_INTEGRITY=true.
JOVI_REQUIRE_INTEGRITY=false
# PLAY_INTEGRITY_PROJECT_NUMBER=
# PLAY_INTEGRITY_PACKAGE=com.jovilens.app
# PLAY_INTEGRITY_CERT_SHA256=
# PLAY_INTEGRITY_SA_JSON_B64=

# --- Acesso de teste do app web (prod-web-android-spec.md §3.2) ------------
# Assina o cookie de teste; nunca sai do servidor. Gere com: openssl rand -hex 32
# Sem valor = acesso de teste desligado.
JOVI_TESTER_KEY=
# Código entregue aos testadores (link https://<domínio>/?acesso=<código>).
# Trocar o código derruba todos os cookies de teste — troque a cada campanha.
JOVI_TESTER_ACCESS_CODE=
# Total de chamadas de IA de testadores por dia (UTC), somando todos.
# JOVI_TESTER_DAILY_CAP=3000

# --- Upstash Redis (REST) -------------------------------------------------
# Injetadas pela integração da Vercel. Lidas nesta ordem: UPSTASH_* e depois KV_*.
# Sem elas, localmente o servidor usa um store em memória.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Créditos e limites ---------------------------------------------------
# JOVI_FREE_CREDITS=3
# Novas contas por IP por dia (UTC).
# JOVI_SIGNUP_LIMIT_PER_IP_DAY=25

# --- Modos ----------------------------------------------------------------
# Demo do servidor (respostas simuladas). Deve ser false em produção.
JOVI_LENS_DEMO_MODE=false
# Só local: pula sessão, integridade, idempotência e créditos para o app web.
# Ignorado sempre que VERCEL está definido. PROIBIDO em produção.
JOVI_LOCAL_DEV_BYPASS=false

# Só local (npm run dev:api): nomes de Host aceitos além de localhost e IPs,
# separados por vírgula. Protege contra DNS rebinding (ver server/app.js).
# JOVI_ALLOWED_HOSTS=

# =========================================================================
# App React Native (EXPO_PUBLIC_*, embutidas no build — visíveis no APK)
# =========================================================================
# APP_VARIANT (development | production | presentation) vem do eas.json ou do shell.

# true só no build de apresentação (demo offline).
EXPO_PUBLIC_JOVI_LENS_DEMO_MODE=false
# Dev: http://127.0.0.1:8787 (com scripts/phone-dev.sh). Produção: https://<domínio-vercel>.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
# O mesmo client ID "Web application" de GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Mesmo valor de JOVI_API_KEY (em produção vem do EAS env, visibilidade "sensitive").
EXPO_PUBLIC_JOVI_API_KEY=
